FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/target/gimvpark-web-1.0.0.jar app.jar
# Vercel serve HTTP na porta 80 por padrão
ENV SERVER_PORT=80
# Sistema de arquivos da Vercel só permite gravar em /tmp (dados NÃO são permanentes)
ENV SPRING_DATASOURCE_URL=jdbc:h2:file:/tmp/gimvpark
ENV GIMV_UPLOAD_DIR=/tmp/uploads
EXPOSE 80
ENTRYPOINT ["java","-jar","app.jar"]
